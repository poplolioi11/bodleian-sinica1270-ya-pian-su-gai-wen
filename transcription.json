      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/c20367ed-e424-4fab-be61-3174e7271d60/full/2000,/0/default.jpg",
      "label": "pp. [4]-[5]",
      "file": "04.jpg",
      "sha256": "0d74398c52608a0ce46e1f45bc4241cad47fd53fee0c04eb102f45969030f974",
      "bytes": 1342196,
      "native_width": 5412,
      "native_height": 6002,
      "content_role": "printed-text",
      "state": "ocr-compared-with-targeted-source-review",
      "sides": [
        {
          "side": "right",
          "columns": [
            {
              "text": "嗜食鴉片為父母者既憂其絕嗣促年又懼"
            },
            {
              "text": "其不法生禍以血氣既衰之人積沈鬱莫解"
            },
            {
              "text": "之憂因憂致疾因疾隕命是何異於人子促"
            },
            {
              "text": "親之壽言念及此不孝之罪真堪痛恨"
            },
            {
              "text": "破家"
            },
            {
              "text": "凡人衣食饒裕或祖父所遺或一己自創一"
            },
            {
              "text": "旦嗜此上引坐食無用兼以混朋宴友吹波"
            }
          ],
          "extras": [
            {
              "type": "running-title",
              "location": "右頁外緣版心",
              "text": "鴉片六戒　一",
              "column_anchor": 7,
              "color": "unknown"
            }
          ]
        },
        {
          "side": "left",
          "columns": [
            {
              "text": "助瀾聚集浪費身家定必銷乏迨饔飧不給"
            },
            {
              "text": "借貸無門甚至質妻賣子途窮自盡者有之"
            },
            {
              "text": "廻思向所享產業經祖父及當身多少辛勤"
            },
            {
              "text": "儉積纔得有此飽暖之福今因嗜此而忽歸"
            },
            {
              "text": "烏有饑寒迫切妻啼子號清夜豈敢捫心到"
            },
            {
              "text": "此悔之何及"
            },
            {
              "text": "害身"
            }
          ],
          "extras": [
            {
              "type": "running-title",
              "location": "左頁外緣版心",
              "text": "鴉片六戒",
              "column_anchor": 7,
              "color": "unknown"
            }
          ]
        }
      ],
      "issues": [
